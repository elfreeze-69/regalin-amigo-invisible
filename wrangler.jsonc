{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "regalin-amigo-invisible",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amigo-invisible-db",
      "migrations_dir": "migrations"
    }
  ]
}
